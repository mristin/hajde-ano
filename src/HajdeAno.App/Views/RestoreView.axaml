<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HajdeAno.App.ViewModels"
    xmlns:c="using:HajdeAno.App.Controls"
    x:Class="HajdeAno.App.Views.RestoreView"
    x:DataType="vm:RestoreViewModel"
>
    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,*,Auto" Margin="4,8">
        <!-- A grid, so that a long file name is shortened instead of running into the
             label of the restored text. -->
        <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,4">
            <TextBlock
                Classes="h2"
                Text="Response from the online service"
                VerticalAlignment="Center"
            />
            <Button
                Grid.Column="1"
                Margin="8,0"
                Content="Open answer…"
                Command="{Binding OpenAnswerCommand}"
                ToolTip.Tip="Open a Word document (.docx), text or Markdown file with placeholders"
            />
            <TextBlock
                Grid.Column="2"
                Text="{Binding WordFileName, StringFormat='Word document: {0}'}"
                ToolTip.Tip="{Binding WordFileName}"
                IsVisible="{Binding IsWord}"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis"
            />
        </Grid>
        <TextBlock
            Grid.Column="2"
            Classes="h2"
            Text="Restored text (review before copying)"
            Margin="0,0,0,4"
        />
        <TextBox
            Grid.Row="1"
            Grid.Column="0"
            Text="{Binding Input}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            PlaceholderText="Paste the answer that contains placeholders such as [PERSON_1]…"
            FontSize="14"
        />
        <Border Grid.Row="1" Grid.Column="2" Classes="card">
            <ScrollViewer>
                <c:HighlightedTextBlock
                    Segments="{Binding OutputSegments}"
                    TextWrapping="Wrap"
                    FontSize="14"
                />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="6" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock
                            Text="{Binding StringFormat='⚠ {0}'}"
                            TextWrapping="Wrap"
                            Foreground="#D13438"
                        />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Restore" Command="{Binding RestoreCommand}" />
                <Button
                    Classes="accent"
                    Content="Copy restored text"
                    Command="{Binding CopyCommand}"
                />
                <Button
                    Classes="accent"
                    Content="Save restored Word document…"
                    Command="{Binding SaveWordCommand}"
                    IsVisible="{Binding IsWord}"
                    ToolTip.Tip="Writes a copy of the Word document with the original names (unencrypted), keeping its formatting"
                />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Classes="hint" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
