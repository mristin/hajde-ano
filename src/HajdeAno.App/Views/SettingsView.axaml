<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HajdeAno.App.ViewModels"
    x:Class="HajdeAno.App.Views.SettingsView"
    x:DataType="vm:SettingsViewModel"
    x:Name="Root"
>
    <ScrollViewer Margin="4,8">
        <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Classes="h2" Text="Local model" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    Text="{Binding ModelPath}"
                    Width="560"
                    PlaceholderText="(automatic: first model found in the model folders)"
                />
                <Button Content="Browse…" Command="{Binding BrowseCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ModelStatus}" Classes="hint" />
            <ItemsControl ItemsSource="{Binding FoundModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <Button
                                Content="Use"
                                FontSize="12"
                                Padding="6,1"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).UseFoundCommand}"
                                CommandParameter="{Binding}"
                            />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Classes="hint"
                FontSize="12"
                Text="{Binding ModelDirectories, StringFormat='Model folders searched:&#x0a;{0}'}"
            />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox IsChecked="{Binding UseGpu}" Content="Use GPU (Metal on Apple Silicon)" />
                <TextBlock Text="Context size" VerticalAlignment="Center" />
                <ComboBox
                    ItemsSource="{Binding ContextSizes}"
                    SelectedItem="{Binding ContextSize}"
                />
                <TextBlock Text="CPU threads (0 = auto)" VerticalAlignment="Center" />
                <NumericUpDown
                    Value="{Binding Threads}"
                    Minimum="0"
                    Maximum="64"
                    Width="120"
                    FormatString="0"
                />
            </StackPanel>

            <TextBlock Classes="h2" Text="Privacy" />
            <CheckBox
                IsChecked="{Binding StrictMode}"
                Content="Strict privacy mode: also replace dates, amounts, nationalities and locations"
            />
            <CheckBox
                IsChecked="{Binding SecondPass}"
                Content="Second detection pass over the anonymized text (slower, safer)"
            />

            <TextBlock Classes="h2" Text="Categories" />
            <ItemsControl ItemsSource="{Binding CategoryToggles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryToggleViewModel">
                        <CheckBox
                            IsChecked="{Binding Enabled}"
                            Content="{Binding Name}"
                            Width="290"
                        />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Save settings" Command="{Binding SaveCommand}" />
                <Button Content="Save and test model" Command="{Binding TestModelCommand}" />
                <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Classes="hint" />
            </StackPanel>
            <TextBlock
                Classes="hint"
                FontSize="12"
                Text="{Binding SessionDirectory, StringFormat='Cases of this session: {0}'}"
            />
            <TextBlock
                Classes="hint"
                FontSize="12"
                Text="{Binding DataDirectory, StringFormat='Settings and recent sessions: {0}'}"
            />
        </StackPanel>
    </ScrollViewer>
</UserControl>
