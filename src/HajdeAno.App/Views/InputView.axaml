<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HajdeAno.App.ViewModels"
    x:Class="HajdeAno.App.Views.InputView"
    x:DataType="vm:InputViewModel"
>
    <DockPanel Margin="4,8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Open TXT / Markdown…" Command="{Binding OpenFileCommand}" />
            <Button Content="Clear" Command="{Binding ClearCommand}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Classes="accent"
                    Content="Detect private information"
                    Command="{Binding DetectCommand}"
                />
                <Button
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding IsBusy}"
                />
                <ProgressBar
                    IsIndeterminate="True"
                    Width="160"
                    IsVisible="{Binding IsBusy}"
                    VerticalAlignment="Center"
                />
                <TextBlock Text="{Binding Progress}" VerticalAlignment="Center" Classes="hint" />
            </StackPanel>
            <TextBlock
                Classes="error"
                Text="{Binding Error}"
                IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
            />
            <TextBlock
                Classes="hint"
                FontSize="12"
                Text="The text stays in memory on this computer. Detection runs on the local model; nothing is sent anywhere."
            />
        </StackPanel>
        <TextBox
            Text="{Binding Text}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            PlaceholderText="Paste the original case description here…"
            FontSize="14"
        />
    </DockPanel>
</UserControl>
