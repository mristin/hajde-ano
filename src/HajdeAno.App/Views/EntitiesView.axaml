<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HajdeAno.App.ViewModels"
    x:Class="HajdeAno.App.Views.EntitiesView"
    x:DataType="vm:EntitiesViewModel"
    x:Name="Root"
>
    <DockPanel Margin="4,8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <ComboBox
                ItemsSource="{Binding AllCategories}"
                SelectedItem="{Binding NewCategory}"
                MinWidth="180"
            />
            <TextBox PlaceholderText="Value, e.g. a name" Text="{Binding NewValue}" Width="280" />
            <Button Content="Add entity" Command="{Binding AddCommand}" />
            <Button Classes="accent" Content="Save changes" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Classes="hint" />
        </StackPanel>
        <Expander DockPanel.Dock="Bottom" Header="Terms marked as not sensitive" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding IgnoredTerms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <Button
                                Content="Detect again"
                                FontSize="12"
                                Padding="6,1"
                                Command="{Binding #Root.((vm:EntitiesViewModel)DataContext).UnignoreCommand}"
                                CommandParameter="{Binding}"
                            />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Entities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EntityItemViewModel">
                        <Border Classes="card" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="200,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <StackPanel Grid.RowSpan="3">
                                    <TextBlock
                                        Text="{Binding Placeholder}"
                                        Foreground="#2563EB"
                                        FontFamily="monospace"
                                        FontWeight="SemiBold"
                                    />
                                    <TextBlock
                                        Text="{Binding CategoryName}"
                                        Opacity="0.7"
                                        FontSize="12"
                                    />
                                    <TextBlock
                                        Text="{Binding FamilyId, StringFormat='family: {0}'}"
                                        Opacity="0.6"
                                        FontSize="11"
                                        IsVisible="{Binding FamilyId, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBox Text="{Binding Value}" PlaceholderText="Full value" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        IsVisible="{Binding IsPerson}"
                                    >
                                        <TextBox
                                            Text="{Binding FirstName}"
                                            PlaceholderText="First name"
                                            Width="200"
                                        />
                                        <TextBox
                                            Text="{Binding LastName}"
                                            PlaceholderText="Last name"
                                            Width="200"
                                        />
                                    </StackPanel>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        IsVisible="{Binding IsOrganization}"
                                    >
                                        <TextBox
                                            Text="{Binding ShortName}"
                                            PlaceholderText="Short name"
                                            Width="200"
                                        />
                                        <TextBox
                                            Text="{Binding Abbreviation}"
                                            PlaceholderText="Abbreviation"
                                            Width="200"
                                        />
                                    </StackPanel>
                                    <TextBox
                                        Text="{Binding Aliases}"
                                        PlaceholderText="Aliases / other spellings, separated by ;"
                                    />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Content="Delete"
                                    VerticalAlignment="Top"
                                    Margin="8,0,0,0"
                                    Command="{Binding #Root.((vm:EntitiesViewModel)DataContext).DeleteCommand}"
                                    CommandParameter="{Binding}"
                                />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
